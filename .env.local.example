# Copy this file to .env.local and fill in your real key.
# .env.local is gitignored - never commit your real key.

# Required. Free key (1 request/sec, 10,000 requests/month):
# https://www.solanatracker.io/account  (Data API tab)
SOLANA_TRACKER_API_KEY=your_api_key_here

# Optional: point the server at a different provider URL (e.g. a local mock for testing).
# SOLANA_TRACKER_BASE_URL=https://data.solanatracker.io

# Optional: canonical site URL for link previews (defaults to your Vercel production URL).
# NEXT_PUBLIC_SITE_URL=https://your-domain.example
